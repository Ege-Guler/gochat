mqtt:
  broker: "broker.hivemq.com"  # Example public MQTT broker
  port: 1883                   # Use 8883 for TLS/SSL connections
  topic: "gochat/exchange"     # Topic for peer discovery and key exchange
  clientID: "gochat-client-1"  # Unique client identifier
  username: ""                 # MQTT broker username (if required)
  password: ""                 # MQTT broker password (if required)
  qos: 1                       # Quality of Service level (0, 1, or 2)
  retain: false                # Whether to retain messages

chat:
  username: "user1"            # Your display name in chat